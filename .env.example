# Copy this file to `.env` (NOT `.env.local`).
# The TinaCMS CLI only reads `.env` / `.env.tina`; it ignores `.env.local`,
# so credentials placed there make `tinacms build` fail with a 401.
# Next.js reads `.env` too, so one file serves both.
#
# Tina Cloud — from app.tina.io → your project → Overview / Tokens
# Safe to expose (it is a public identifier):
NEXT_PUBLIC_TINA_CLIENT_ID=

# Read-only content token. SECRET — never commit a filled-in value.
TINA_TOKEN=

# Branch Tina reads and writes. Vercel sets VERCEL_GIT_COMMIT_REF
# automatically, so this is only needed for local overrides.
# GITHUB_BRANCH=main
